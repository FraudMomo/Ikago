<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Renderer, GPU, plugin and alert helpers run web content or drawing and never open a device.
	     Only the app and the base helper, which hosts Chromium's capture service, get camera and microphone. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
